#
# Results notification utility configuration
# -------------------------------------------------------------------------
# USAGE: Replace <PLACEHOLDERS> with your specific environment details.
# This utility polls the Job Results Queue and notifies the user/system.
# -------------------------------------------------------------------------

[DEFAULT]
# A unique identifier used to match your other infrastructure resources
Username = <YOUR_USERNAME>
 
# GAS parameters
[gas]
# The base URL where your web application is hosted
# Example: https://myapp.example.com or http://localhost:5000
WebAppBaseUrl = https://${Username}.<YOUR_DOMAIN_OR_IP>

# AWS SQS Settings
[sqs]
# The URL of the SQS queue that receives job completion messages
# Replace <ACCOUNT_ID> with your 12-digit AWS Account ID
JobResultsQueueUrl = https://sqs.us-east-1.amazonaws.com/<ACCOUNT_ID>/${Username}_job_results

### EOF