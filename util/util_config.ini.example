#
# Shared utility configuration parameters
# -------------------------------------------------------------------------
# NOTE: Utility scripts should read this config file BEFORE their 
# specific configuration files to load these shared default values.
# -------------------------------------------------------------------------

[DEFAULT]
# A unique identifier (e.g., your username) used to prefix resources
Username = <YOUR_USERNAME>

# GAS parameters
[gas]
AccountsDatabase = ${Username}_accounts
AnnotationsTable = ${Username}_annotations
# The email address used as the 'From' field for notifications
MailDefaultSender = ${Username}@<YOUR_EMAIL_DOMAIN>.com

# AWS general settings
[aws]
AwsRegionName = us-east-1

# AWS S3 settings
[s3]
# Ensure these buckets exist in your AWS S3 console
InputsBucketName = <YOUR_INPUT_BUCKET_NAME>
ResultsBucketName = <YOUR_RESULTS_BUCKET_NAME>
KeyPrefix = ${Username}/

# AWS Glacier settings
[glacier]
# The name of your Amazon S3 Glacier Vault
VaultName = <YOUR_GLACIER_VAULT_NAME>

# AWS SQS Settings
[sqs]
WaitTime = 20
MaxMessages = 10

### EOF