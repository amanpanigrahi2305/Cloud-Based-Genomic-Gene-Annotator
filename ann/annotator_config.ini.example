#
# GAS Annotator Configuration Template
# -------------------------------------------------------------------------
# USAGE: Replace all <PLACEHOLDERS> with your specific AWS resource details.
# Ensure that the AWS IAM user running this application has the necessary
# permissions for S3, SNS, SQS, and Step Functions.
# -------------------------------------------------------------------------

[DEFAULT]
# A unique identifier (e.g., your username) to prevent resource naming conflicts
Username = <YOUR_USERNAME>

[gas]
# The name of your DynamoDB table for tracking annotations
AnnotationsTable = <YOUR_DYNAMODB_TABLE_NAME>

[aws]
# The AWS region where your resources are hosted (e.g., us-east-1)
AwsRegionName = <YOUR_AWS_REGION>

[s3]
# S3 bucket names for input files and processed results
InputsBucketName = <YOUR_INPUT_BUCKET_NAME>
ResultsBucketName = <YOUR_RESULTS_BUCKET_NAME>
KeyPrefix = ${Username}/

[sns]
# Amazon SNS Topic ARNs for job requests and results notifications
JobRequestTopicArn = arn:aws:sns:<REGION>:<ACCOUNT_ID>:<JOB_REQUEST_TOPIC_NAME>
JobResultsTopicArn = arn:aws:sns:<REGION>:<ACCOUNT_ID>:<JOB_RESULTS_TOPIC_NAME>

[sqs]
# Amazon SQS Queue URL for polling job requests
JobRequestsQueueUrl = https://sqs.<REGION>.amazonaws.com/<ACCOUNT_ID>/<QUEUE_NAME>
WaitTime = 20
MaxMessages = 10

[sfn]
# AWS Step Functions State Machine ARN for handling archive delays
ArchiveDelayStateMachineArn = arn:aws:states:<REGION>:<ACCOUNT_ID>:stateMachine:<STATE_MACHINE_NAME>

### EOF